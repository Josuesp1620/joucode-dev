{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "joucode-dev",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-02-25",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "html_handling": "drop-trailing-slash"
  },
  "observability": {
    "enabled": true
  }
}
