import examenV1 from '../../assets/blog/s1-code/fig8-examen.png';
import dificultad from '../../assets/blog/s1-code/fig9-dificultad.png';
import validacionV1 from '../../assets/blog/s1-code/fig10-validacion.png';
import testV2 from '../../assets/blog/s1-code/fig11-test-v2.png';
import idiomasV2 from '../../assets/blog/s1-code/fig12-idiomas-v2.png';
import entrenamientoV2 from '../../assets/blog/s1-code/fig13-entrenamiento-v2.png';
import datosV2 from '../../assets/blog/s1-code/fig14-datos-v2.png';
