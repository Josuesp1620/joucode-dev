import Figura from '../../components/blog/Figura.astro';
import Icono from '../../components/Icono.astro';
import { ARTICULOS, ENLACES_S1 } from '../../data/blog';
import { PERSONA } from '../../data/perfil';

import experimentoLaya from '../../assets/blog/s1-code/en/fig1-experimento-laya.png';
import experimentoEmbeddings from '../../assets/blog/s1-code/en/fig2-experimento-embeddings.png';
import brechaIdioma from '../../assets/blog/s1-code/en/fig3-idiomas.png';
import costoCalidad from '../../assets/blog/s1-code/en/fig4-costo-calidad.png';
import latencia from '../../assets/blog/s1-code/en/fig5-latencia-cpu.png';
import entrenamientoV1 from '../../assets/blog/s1-code/en/fig7-entrenamiento.png';
import examenV1 from '../../assets/blog/s1-code/en/fig8-examen.png';
import dificultad from '../../assets/blog/s1-code/en/fig9-dificultad.png';
import validacionV1 from '../../assets/blog/s1-code/en/fig10-validacion.png';
import testV2 from '../../assets/blog/s1-code/en/fig11-test-v2.png';
import idiomasV2 from '../../assets/blog/s1-code/en/fig12-idiomas-v2.png';
import entrenamientoV2 from '../../assets/blog/s1-code/en/fig13-entrenamiento-v2.png';
import datosV2 from '../../assets/blog/s1-code/en/fig14-datos-v2.png';
import practicaRealidad from '../../assets/blog/s1-code/en/fig15-practica-realidad-v2.png';
import tiposV2 from '../../assets/blog/s1-code/en/fig16-tipos-v2.png';
import prediccionV2 from '../../assets/blog/s1-code/en/fig17-prediccion-v2.png';
import rivalesV3 from '../../assets/blog/s1-code/en/fig18-rivales-v3.png';
import entrenamientoV3 from '../../assets/blog/s1-code/en/fig19-entrenamiento-v3.png';
import evolucionV3 from '../../assets/blog/s1-code/en/fig20-evolucion-v3.png';
import capacidadGeneral from '../../assets/blog/s1-code/en/fig21-capacidad-general.png';
import resultadoV01 from '../../assets/blog/s1-code/en/fig22-s1grep-v01.png';
import lenguajes from '../../assets/blog/s1-code/en/fig23-lenguajes.png';
import velocidad from '../../assets/blog/s1-code/en/fig24-velocidad.png';
import repositoriosGrandes from '../../assets/blog/s1-code/en/fig25-repositorios-grandes.png';
