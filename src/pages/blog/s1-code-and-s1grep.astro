const articulo = ARTICULOS.find((entrada) => entrada.slug === 's1-code-and-s1grep')!;

const SITIO = 'https://joucode.apiservicesac.com';
const VERSIONES = [
  { lang: 'es' as const, href: `${SITIO}/blog/${articulo.traduccion}` },
  { lang: 'en' as const, href: `${SITIO}/blog/${articulo.slug}` },
];

const CIFRAS = [
  { valor: '168 / 201', texto: 'real searches with the right function ranked first (embeddings alone: 145)' },
  { valor: '83% · 85%', texto: 'accuracy in English and Spanish: the language of the question barely matters' },
  { valor: '1.3 s', texto: 'per search on an ordinary CPU, no GPU and no cloud, with the models already loaded' },
  { valor: '9 languages', texto: 'Python, JavaScript, TypeScript, Go, Java, PHP, Rust, Ruby and C#' },
];

const INDICE = [
  { id: 'summary', texto: 'In short' },
  { id: 'question', texto: 'The question' },
  { id: 'system-one', texto: 'What a System One model is' },
  { id: 'exploration', texto: '1 · Measure before building' },
  { id: 'engineering', texto: '2 · Getting the model out of Python' },
  { id: 'data', texto: '3 · Building the data' },
  { id: 'v1', texto: '4 · s1-code v1' },
  { id: 'v2', texto: '5 · s1-code v2' },
  { id: 'v3', texto: '6 · s1-code v3' },
  { id: 's1grep', texto: '7 · s1grep, the product' },
  { id: 'languages', texto: '8 · Other languages' },
  { id: 'product', texto: '9 · From prototype to product' },
  { id: 'rejected', texto: 'What we tried and dropped' },
  { id: 'lessons', texto: 'Lessons' },
  { id: 'limits', texto: 'Limits and costs' },
  { id: 'next', texto: 'What comes next' },
  { id: 'resources', texto: 'Resources' },
];

const boton = 'inline-flex items-center gap-2 rounded-xl px-4 py-2.5 text-sm font-semibold transition';
---

<Layout title={`${articulo.titulo} · Josue Salazar`} description={articulo.resumen} lang="en" alternates={VERSIONES}>
  <Cabecera idioma="en" />

  <main>
    <!-- Article header -->
    <section class="border-b border-borde bg-tarjeta">
      <div class="mx-auto max-w-contenido px-5 pb-14 pt-12 md:px-8 md:pt-16">
        <div class="flex flex-wrap items-center justify-between gap-4">
          <a href="/blog" class="inline-flex items-center gap-2 font-mono text-xs font-medium tracking-[0.18em] text-azul hover:underline">← BLOG · CASE STUDY</a>
          <a href={`/blog/${articulo.traduccion}`} hreflang="es" lang="es" class="inline-flex items-center gap-2 rounded-full border border-borde bg-fondo px-3.5 py-1.5 text-sm font-semibold text-tinta transition hover:border-azul/40 hover:text-azul"><span class="font-mono text-[11px] tracking-wider text-tenue">ES</span> Leer en español <Icono nombre="flecha" /></a>
        </div>
        <h1 class="mt-5 max-w-4xl text-4xl font-extrabold leading-[1.08] md:text-[3.4rem]">{articulo.titulo}</h1>
        <p class="mt-6 max-w-3xl text-lg leading-relaxed text-tinta2 md:text-xl">{articulo.resumen}</p>
        <div class="mt-8 flex flex-wrap items-center gap-x-5 gap-y-3">
          <div class="flex items-center gap-3">
            <img src={PERSONA.foto} alt="" class="h-10 w-10 rounded-full" width="40" height="40" />
            <div class="leading-tight">
              <p class="font-bold">{PERSONA.nombre}</p>
              <p class="text-sm text-tenue">Founder and CEO · API SERVICE SAC</p>
            </div>
          </div>
          <span class="hidden h-8 w-px bg-borde sm:block" aria-hidden="true" />
          <p class="font-mono text-xs text-tenue">{articulo.fechaTexto} · {articulo.lectura}</p>
        </div>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={ENLACES_S1.modeloV3} target="_blank" rel="noopener" class={`${boton} bg-tinta text-white hover:bg-azul`}>s1-code v3 on Hugging Face <Icono nombre="externo" /></a>
          <a href={ENLACES_S1.s1grep} target="_blank" rel="noopener" class={`${boton} border border-borde bg-fondo hover:border-tinta/30`}><Icono nombre="github" /> s1grep on GitHub</a>
        </div>
        <dl class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {CIFRAS.map((cifra) => (
            <div class="rounded-2xl border border-borde bg-fondo p-5">
              <dt class="text-2xl font-extrabold tabular-nums text-tinta md:text-3xl">{cifra.valor}</dt>
              <dd class="mt-2 text-sm leading-snug text-tinta2">{cifra.texto}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <div class="mx-auto grid max-w-contenido gap-12 px-5 pb-24 pt-12 md:px-8 lg:grid-cols-[220px_minmax(0,1fr)]">
      <!-- Table of contents -->
      <aside class="hidden lg:block">
        <nav class="sticky top-24" aria-label="Article contents">
          <p class="font-mono text-[11px] font-medium tracking-[0.18em] text-tenue">CONTENTS</p>
          <ol class="mt-4 space-y-2 border-l border-borde text-sm">
            {INDICE.map((entrada) => (
              <li><a href={`#${entrada.id}`} class="-ml-px block border-l border-transparent pl-4 text-tinta2 hover:border-azul hover:text-tinta">{entrada.texto}</a></li>
            ))}
          </ol>
        </nav>
      </aside>

      <article class="prosa min-w-0 max-w-[760px]">
        <blockquote>
          <strong>About this work:</strong> this is the first model I have trained. I come from software engineering, not from AI research, so I worked with one simple rule: no decision without a measurement. Predictions were written before seeing the results, the final exams were opened only once, and this article also covers what did not work.
        </blockquote>

        <h2 id="summary">In short</h2>
        <ul>
          <li><strong>Laya, an open System One model, could not judge code</strong>: it got 1 of 20 searches right, the same as chance. We measured that in one afternoon, before building anything on top of it.</li>
          <li><strong>We trained our own model, s1-code</strong>, in three versions. On its own, v3 gets 161 of 197 never-seen real searches right, against 144 for v1 (p = 0.002) and 152 for Qwen3-Embedding.</li>
          <li><strong>We built s1grep</strong>, a local search tool in Rust: it ranks the right function first in 168 of 201 real searches, against 145 for embeddings alone, equally in English and Spanish.</li>
          <li><strong>We took it from prototype to product</strong> over five releases (0.2 to 0.5): nine languages, large repositories searchable within minutes, keyword search where it helps, a background process nobody has to start, and a tool for coding agents. The exam held at 168 of 201 in every release.</li>
          <li><strong>Not everything worked</strong>: v3 does not reliably beat v2, large GPU models are still better judges, and in other languages the judge helps Java but hurts JavaScript and Go. All of that is measured and reported here.</li>
        </ul>

        <h2 id="question">The question</h2>
        <p>
          Coding agents and people lose a lot of time looking for <em>where</em> something lives in a repository. grep finds words, not intentions: if you ask "where is a failed payment retried", the function may be called <code>send_with_retry</code> and contain none of the words in your question.
        </p>
        <p>
          Tools like <a href="https://github.com/dzhng/jevgrep" target="_blank" rel="noopener">jevgrep</a> solve this by sending your code to a model in the cloud. Our question was a different one:
        </p>
        <blockquote>
          Can we build a local, open and bilingual (English and Spanish) alternative that finds code by what it does, using System One models, and runs on an ordinary CPU?
        </blockquote>
        <p>The short answer is <strong>yes, with caveats</strong>. This article covers the 18 steps that led there, including what worked and what did not.</p>

        <h2 id="system-one">What a System One model is</h2>
        <p>
          A System One model does not write text. It takes a document and <em>typed</em> questions (pick an option, true or false, or a scale) and returns probabilities in a single pass. That makes it fast, it does not "hallucinate", and its answers can be calibrated: a 90% should be right 9 times out of 10.
        </p>
        <p>s1-code takes a function and a question, and returns the probability that the function answers the search:</p>
        <pre><code>[CLS] noul question: This code answers the search: where is a failed payment retried [SEP]
      [MASK] no  [MASK] yes [SEP]
billing/gateway/client.py
GatewayClient.send_with_retry

def send_with_retry(self, document, attempts=3): ... [SEP]
→ yes: 0.93</code></pre>
        <p>
          We started from <a href="https://github.com/NandhaKishorM/laya" target="_blank" rel="noopener">Laya</a> (Convai Innovations, Apache 2.0), a 322-million-parameter multilingual System One model. s1-code is Laya fine-tuned for a single task: deciding whether a piece of code answers a search. Technically, it is a System One model used as a <em>reranker</em>.
        </p>

        <h2 id="exploration">Phase 1 · Measure before building</h2>
        <h3>Does Laya understand code?</h3>
        <p>
          Before writing the search tool we ran a cheap test: 20 questions over 1,531 functions from private Python backend service repositories. A keyword search (BM25) picked 25 candidates and Laya ranked them using four different ways of asking.
        </p>
        <Figura imagen={experimentoLaya} alt="Bar chart: BM25 gets 13 of 20 right and Laya between 0 and 1, the same as chance" pie="Laya got 0 or 1 of 20 right, the same as chance; BM25 got 13. It also said “yes” with 97% confidence to false statements." />
        <p>Conclusion: <strong>do not build on Laya as it is</strong>. That 13-minute test saved weeks of work on a model that was not fit for this.</p>

        <h3>Do embeddings find the code?</h3>
        <p>
          We put together an exam of 53 real questions taken from commits and compared BM25, three embedding models, their fusion with BM25 and two rerankers, searching across every function in the repositories.
        </p>
        <Figura imagen={experimentoEmbeddings} alt="Three panels with top 1, top 5 and top 20 for seven search methods" pie="Embeddings find the code: Qwen3-Embedding puts the right one in the top 5 for 49 of 53. Mixing in BM25 makes it worse, and the large rerankers help a little but cost up to 27 s per search on a CPU." />
        <Figura imagen={brechaIdioma} alt="Dot plot with English and Spanish accuracy per method" pie="The language gap: asking in Spanish about code written in English. BM25 finds only 3 of 22 Spanish questions; multilingual embeddings close much of that gap." />
        <p>
          We also reviewed what already existed: there are open semantic code search tools (ck, osgrep and others), but <strong>none has a local System One judge trained for code</strong>. That was the gap we decided to fill.
        </p>

        <h2 id="engineering">Phase 2 · Getting the model out of Python</h2>
        <p>For the product to be a single binary, without Python, the model had to run on ONNX Runtime from Rust. Four findings:</p>
        <ul>
          <li><strong>The official exporter was broken</strong>: it fixed the text length at 16 tokens and failed on anything longer. With PyTorch's <em>dynamo</em> exporter, ONNX matches the original on all 14 test questions.</li>
          <li><strong>INT8 does not speed it up</strong>: dynamic quantization pushes every answer to 0.5, and weight-only quantization keeps the quality but is slower on a CPU. We kept float32.</li>
          <li><strong>The Rust engine gives the same results as Python</strong>: identical tokens and probabilities within ±0.0006, on Windows too. Every new implementation gets its own <em>parity test</em>.</li>
          <li><strong>The bfloat16 mistake</strong>: three models shipped in bfloat16, and the CPU has no instructions for that format. In float32 they index 5.8 times faster with the same result.</li>
        </ul>
        <Figura imagen={latencia} alt="Bars of milliseconds per chunk by text length on two CPUs" pie="Four times more text costs six times more time. This is where the funnel design came from: a cheap filter brings about 25 candidates and the judge reads only those, as short functions rather than whole files." />
        <Figura imagen={costoCalidad} alt="Scatter of quality against indexing seconds, with arrows from bfloat16 to float32" pie="Quality against indexing cost. The hollow circles are the same models in bfloat16: just as good and up to 6 times slower on a CPU." />

        <h2 id="data">Phase 3 · Building the data</h2>
        <p>
          Training a judge takes thousands of "search → right function" pairs. We generated them "backwards": pick a function, and an open model (Qwen3-8B) writes the search someone who needs it would type, in English or Spanish and in one of six styles. A filter drops the ones that repeat the function name.
        </p>
        <div class="tabla"><table>
          <thead><tr><th>v1 data</th><th>Count</th></tr></thead>
          <tbody>
            <tr><td>Public Python repositories with a permissive license</td><td class="num">306</td></tr>
            <tr><td>Unique functions, without tests or examples</td><td class="num">799,635</td></tr>
            <tr><td>Accepted questions (83%)</td><td class="num">30,068</td></tr>
            <tr><td>Training examples (1 right answer and 3 decoys per question)</td><td class="num">113,008</td></tr>
            <tr><td>Validation questions, from 16 never-seen repositories</td><td class="num">400</td></tr>
          </tbody>
        </table></div>
        <p>
          Reviewing two samples of 50 questions by hand, which cost cents, caught template phrases, leaked tests and generic questions. Fixing them before generating the 36,000 raised acceptance from 80% to 87%.
        </p>
        <p>
          To teach it to say "no", every question comes with <strong>hard decoys</strong>: the most similar functions from the same repository that are not the right one.
        </p>
        <Figura imagen={dificultad} alt="Bars comparing the difficulty of generated and real questions" pie="The generated questions turned out harder than the real ones: granite ranks the right one first in 50% of the generated questions and in 66% of the exam questions." />

        <h2 id="v1">Phase 4 · s1-code v1</h2>
        <p>
          Fine-tuning of multilingual Laya with its authors' recipe, 2 epochs on an NVIDIA L4 GPU in the cloud (93 minutes), and calibration on 1,000 held-out examples. Before training we set the bar, beating granite alone (35 of 53), and the goal: 44.
        </p>
        <Figura imagen={entrenamientoV1} alt="Training loss curve for v1" pie="The loss falls from 0.45 to 0.13. The sharp drop at the start of epoch 2 is normal, but it is also the typical sign that memorization may begin." />
        <Figura imagen={validacionV1} alt="Validation accuracy bars for granite, Laya and s1-code v1" pie="On 400 questions from never-seen repositories, s1-code v1 rises from 51% to 80% and performs the same in English and Spanish: it learned to judge code, it did not memorize repositories." />
        <Figura imagen={examenV1} alt="Bars with the result of the original 53-question exam" pie="With real questions from commits the gain shrinks: 38 of 53, above the bar (35) and far from the goal (44)." />
        <p>
          Then we built a bigger exam: 202 real questions split into <strong>dev</strong> (100, for making decisions) and <strong>test</strong> (102, opened only once). And we changed the rival: a cascade judge has to beat the <em>strongest</em> cheap search, Qwen3-Embedding, not the weakest. Against that rival, v1's advantage was no longer reliable.
        </p>

        <h2 id="v2">Phase 5 · s1-code v2: more data, exact parity</h2>
        <p>
          v2 added sources with human-written questions and verified licenses: commit messages (CommitPackFT), issues linked to the fixed function (SWE-bench, SWE-Gym, SWE-smith), human searches (CoSQA) and functions from the organization's private repositories, filtered for secrets and personal data. Every question got a twin in the other language.
        </p>
        <Figura imagen={datosV2} alt="Bars per data source and language share in v1 and v2" pie="81,412 training questions, exactly half in English and half in Spanish: 2.9 times as many examples as v1." />
        <Figura imagen={entrenamientoV2} alt="Training loss curve for v2" pie="v2 training on an A100 (64 minutes). The second epoch made dev worse: it was memorizing, so we kept the first." />
        <p>
          On validation, v2 looked far ahead (315 against 269 of 400). Breaking it down by question type revealed a <strong>shortcut</strong>: it scored 100% on CoSQA questions because it recognized the style of the right answer, not the search.
        </p>
        <Figura imagen={tiposV2} alt="Validation accuracy bars by question type" pie="The 100% on CoSQA was a dataset shortcut. Without those questions, v1 and v2 tie (266 against 268 of 353; p = 0.89)." />
        <Figura imagen={prediccionV2} alt="Comparison between the prediction written beforehand and what was measured" pie="The prediction written before opening test (judge 74–78, combined with Qwen3 82–86, no reliable difference from v1) held: 74, 83 and p = 0.34." />
        <Figura imagen={testV2} alt="Bars with the 102-question test per system" pie="The earlier test, opened only once: v2 + Qwen3 gets 86 of 102 against 80 for Qwen3 alone, but the difference is not statistically reliable (p = 0.21)." />
        <Figura imagen={idiomasV2} alt="Accuracy bars per language on test" pie="What v2 did achieve: a zero-point gap between English and Spanish (84% and 84%)." />
        <Figura imagen={practicaRealidad} alt="Bars per set and language comparing validation and the real exam" pie="Practice versus reality: generated and real questions do not behave the same, which is why every decision was made on real questions." />
        <p><strong>An honest verdict on v2</strong>: good research work and a tie as a model. What really improved was our ability to tell.</p>

        <h2 id="v3">Phase 6 · s1-code v3: a teacher and memorization control</h2>
        <p>
          We analyzed v2's 25 failures: 12 had the right one in 2nd place and 9 confused it with a sibling method of the same class. We tried four <strong>teacher</strong> candidates on the same questions. The best was Qwen3-Reranker-4B (89 of 100 on dev); the most eye-catching, the 9B Nimble, came in below it. Picking the teacher with a test cost less than 1 USD.
        </p>
        <p>v3 was trained with:</p>
        <ul>
          <li>72,332 groups of 1 right answer and 7 decoys drawn from the real search (Qwen3-Embedding), with exact language parity.</li>
          <li>A loss that makes the right answer compete against its decoys.</li>
          <li>Teacher scores on 20,000 groups, mixed 50/50 with the real labels.</li>
          <li>A memorization check every 1,000 steps and early stopping.</li>
        </ul>
        <Figura imagen={entrenamientoV3} alt="Validation, already-seen data and overconfidence curves during v3 training" pie="Validation rose from 72% to 82% at step 13,000 and plateaued; early stopping cut at 17,000 and restored 13,000. The memorization gap stayed stable and overconfidence below 1%." />
        <p>To measure it, agents wrote a <strong>new test</strong> of 197 questions about functions that did not appear in any earlier exam. It was opened only once, with the prediction written beforehand.</p>
        <Figura imagen={rivalesV3} alt="Bars with confidence intervals for s1-code v3 against teachers and rivals" pie="s1-code v3 against teachers and rivals on the new test. The 4-billion and 9-billion-parameter models are still ahead, but they need a GPU." />
        <div class="tabla"><table>
          <thead><tr><th>System</th><th>Size</th><th>Top-1 (of 197)</th><th>English</th><th>Spanish</th></tr></thead>
          <tbody>
            <tr><td>Qwen3-Reranker-4B (teacher)</td><td>4,000M · GPU</td><td class="num">183</td><td class="num">91%</td><td class="num">95%</td></tr>
            <tr><td>Nimble</td><td>9,000M · GPU</td><td class="num">177</td><td class="num">90%</td><td class="num">90%</td></tr>
            <tr class="destacada"><td>s1-code v3 + Qwen3-Embedding</td><td>322M · CPU</td><td class="num">168</td><td class="num">85%</td><td class="num">85%</td></tr>
            <tr><td>s1-code v2 + Qwen3-Embedding</td><td>322M · CPU</td><td class="num">165</td><td class="num">83%</td><td class="num">84%</td></tr>
            <tr class="destacada"><td>s1-code v3, judge alone</td><td>322M · CPU</td><td class="num">161</td><td class="num">82%</td><td class="num">81%</td></tr>
            <tr><td>jina-reranker-v2 (non-commercial)</td><td>278M · CPU</td><td class="num">158</td><td class="num">78%</td><td class="num">82%</td></tr>
            <tr><td>Qwen3-Embedding alone</td><td>600M</td><td class="num">152</td><td class="num">76%</td><td class="num">78%</td></tr>
            <tr><td>s1-code v1, judge alone</td><td>322M · CPU</td><td class="num">144</td><td class="num">68%</td><td class="num">78%</td></tr>
          </tbody>
        </table></div>
        <Figura imagen={evolucionV3} alt="Evolution of the judge from v1 to v3" pie="The real progress is in the judge on its own: from 144 to 161 from v1 to v3 (p = 0.002), with the language gap going from 11 points to 0. Between consecutive versions, the gain is too small for the size of the exam." />
        <p>
          <strong>Against the rule set beforehand</strong>: v3 had to reliably beat both v2 and Qwen3 alone. It beats Qwen3 alone (p = 0.0015) but not v2 (p = 0.65). The full rule was not met, just as the written prediction expected (about a 30% chance).
        </p>
        <Figura imagen={capacidadGeneral} alt="Accuracy bars on general decisions for base Laya and s1-code" pie="An extra test: on 2,000 decisions that are not about code, base Laya gets 35% right and s1-code drops to 27–29%. s1-code is a code-relevance specialist, not a general System One model." />

        <h2 id="s1grep">Phase 7 · s1grep: the product</h2>
        <p>With the model frozen, we built the search tool around it. It works in four steps, all on your CPU:</p>
        <ol>
          <li><strong>Index</strong>: tree-sitter splits each file into functions and methods; granite turns each one into a vector, stored in SQLite outside the repository. Only changed files are read again.</li>
          <li><strong>Search</strong>: the question becomes a vector and the 25 closest functions come out.</li>
          <li><strong>Judge</strong>: s1-code v3 reads the top 5 and answers with a probability.</li>
          <li><strong>Combine</strong>: the judge's ranking and the search ranking are fused with weights chosen on dev, never on test.</li>
        </ol>
        <Figura imagen={resultadoV01} alt="Bars of granite alone against s1grep v0.1 per language" pie="s1grep v0.1 on the test of 201 real searches: 168 ranked first against 145 for embeddings alone, and 189 in the top 5. English and Spanish come out even." />
        <h3>Speed</h3>
        <p>
          Cutting what the judge reads to 256 or 192 tokens makes it faster, but drops accuracy below not using it at all, because it was trained reading 384. What did work was judging the candidates one at a time instead of in a batch (25% faster, same answers) and keeping the models loaded in memory.
        </p>
        <Figura imagen={velocidad} alt="Bars of seconds per search without and with the background process" pie="Most of the time went into loading about 2.5 GB of models on every search. A background process, which starts by itself with the first search, keeps them in memory and each search drops to 1.3 s." />
        <h3>How to use it</h3>
        <pre><code>s1grep setup                                     # download the models, once
s1grep "where is a failed payment retried" .     # search
s1grep index .                                   # index a large repository and follow its progress
s1grep status                                    # what is loaded and how much is indexed
s1grep mcp                                       # tools for agents: search_code and index_status
s1grep skill --install                           # usage guide for Claude Code</code></pre>
        <p>
          It is a single binary for Linux and Windows, without Python. Nobody has to start or stop anything: the first search brings up a background process that only listens on your machine, with a key only your user can read, and shuts down after 30 minutes without use.
        </p>

        <h2 id="languages">Phase 8 · Does it work for other languages?</h2>
        <p>
          s1-code was trained on Python only. To find out whether it works in other languages, we built an exam from CodeSearchNet: 100 searches per language over public repositories, with granite bringing the candidates from the same repository.
        </p>
        <Figura imagen={lenguajes} alt="Arrows per language showing the change in accuracy when the judge is used" pie="The judge helps in Java (+10) and PHP (+3), changes nothing in Ruby and hurts JavaScript (−8) and Go (−6). With 100 questions per language, each difference has a margin of about ±9 points." />
        <p>
          Our prediction, written beforehand, said no language would end up below granite alone. <strong>It failed in two.</strong> The first version of s1grep was limited to Python; since 0.2.6 it reads nine languages with the same judge, and this table is published so everyone knows what to expect. The real fix is a judge trained on several languages.
        </p>

        <h2 id="product">Phase 9 · From prototype to product (s1grep 0.2 to 0.5)</h2>
        <p>
          Version 0.1 proved the idea, but on a large repository the first search could take minutes, a server had to be started by hand, and it only understood Python. Before adding more features, we wrote down the product architecture, its documented decisions, and one rule for every change: <strong>the 201-search exam cannot go down</strong>. Over the next five releases it held at 168.
        </p>

        <h3>Large repositories: searchable within minutes</h3>
        <p>
          Indexing the full code of each function runs at about 5 to 10 per second on a CPU: a 25,000-function repository takes hours. The fix was to index in two passes. First an <strong>outline</strong> of each function (path, name and first lines), which is enough to search the whole repository; then, in the background, the full code, which is what gives the final quality. Searches answer from the first moment and report how much of the repository is searchable so far.
        </p>
        <div class="tabla"><table>
          <thead><tr><th>Outlines with</th><th>Top-1 (of 201)</th><th>Top-5</th><th>Speed</th></tr></thead>
          <tbody>
            <tr><td>granite 278M, the main model</td><td class="num">135</td><td class="num">167</td><td class="num">1×</td></tr>
            <tr class="destacada"><td>granite 97M, a smaller model</td><td class="num">133</td><td class="num">166</td><td class="num">3.3×</td></tr>
          </tbody>
        </table></div>
        <p>
          For outlines, a model three times smaller performs almost the same, so s1grep uses both: the small one for the first pass and the main one for the final pass. With the full repository indexed, search is exactly what it was before.
        </p>
        <Figura imagen={repositoriosGrandes} alt="Bars of the first search and the time until everything is searchable, in two versions" pie="A repository of about 25,000 functions indexed from scratch: the first search goes from 514 s to 18 s and the whole repository becomes searchable in about 7 minutes." />

        <h3>Nine languages</h3>
        <p>
          Each language is a tree-sitter query of a few lines that says what a function is and what its container is called (a class, a Rust <code>impl</code>, the receiver of a Go method). Adding a language does not touch the rest of the code. Python keeps the extractor the model was trained and examined with, so its results do not change.
        </p>

        <h3>Keyword search only where it helps</h3>
        <p>
          Search by meaning fails on what people look up literally: an exact name (<code>parse_config</code>) or an error message copied from a log. For that, each repository also has a keyword index (BM25), with a tokenizer built for code that splits <code>camelCase</code> and <code>snake_case</code> and does not depend on any human language.
        </p>
        <p>
          Using it on every search made the exam worse: a Spanish question shares few words with code written in English, so the keyword list only added noise. The published rule decides by the shape of the query: if it looks like code, all of its words count; if it is a sentence, only exact matches do.
        </p>
        <Figura imagen={palabras} alt="Accuracy bars with and without keyword search for three kinds of query" pie="With the rule, natural-language questions do not change (168 of 201), function names rise from 149 to 151 and text pasted from the code from 52 to 63 of 84." />

        <h3>A judge that stops when it is sure</h3>
        <p>
          The judge reads the candidates in order and each read costs about 0.4 seconds. If one goes above 90% probability, there is no need to read the rest.
        </p>
        <div class="tabla"><table>
          <thead><tr><th>The judge reads</th><th>Top-1 (of 201)</th><th>Reads per search</th></tr></thead>
          <tbody>
            <tr><td>Always all 5</td><td class="num">168</td><td class="num">5.0</td></tr>
            <tr class="destacada"><td>Until one goes above 90%</td><td class="num">168</td><td class="num">3.3</td></tr>
            <tr><td>Until one goes above 80%</td><td class="num">166</td><td class="num">2.8</td></tr>
            <tr><td>Always only 3</td><td class="num">165</td><td class="num">3.0</td></tr>
          </tbody>
        </table></div>

        <h3>For coding agents</h3>
        <p>
          The background process uses two threads: one answers instantly (whether it is alive, its status, stopping it) even while the other is searching or indexing, and a search abandoned by its client is cancelled. Over MCP, agents get two tools: <code>search_code</code>, with paging, coverage notes and progress notifications, and <code>index_status</code>. The protocol, the architecture decisions and the exams are documented in the repository.
        </p>

        <h2 id="rejected">What we tried and dropped</h2>
        <p>Every idea was measured on the same exam before going in. These did not make it:</p>
        <Figura imagen={modelosRapidos} alt="Scatter of speed against accuracy for four ways of running the search model" pie="No way of speeding up the main model kept its hits: INT8 weights are 1.25 to 1.3 times faster and lose 5 to 21 searches; the small model for everything is 2.3 times faster and loses 14." />
        <div class="tabla"><table>
          <thead><tr><th>Idea</th><th>Result</th><th>Decision</th></tr></thead>
          <tbody>
            <tr><td>INT8 weights for the search model</td><td>1.3× faster, 163 of 201 at best</td><td>Dropped</td></tr>
            <tr><td>The small model for full code as well</td><td>2.3× faster, 154 of 201</td><td>Outlines only</td></tr>
            <tr><td>2-line outlines instead of 4</td><td>Just as fast, 129 of 201 instead of 135</td><td>Dropped</td></tr>
            <tr><td>Reading fewer tokens per function</td><td>The typical function has about 160 tokens: cutting to 384 saves 6–10%</td><td>Dropped</td></tr>
            <tr><td>Two judges in parallel</td><td>Each read goes from 0.39 s to 1.06 s: the CPU is bound by memory, not by cores</td><td>Dropped</td></tr>
            <tr><td>Keyword search on every query</td><td>145 to 155 of 201, mostly because of the Spanish questions</td><td>Only with the rule</td></tr>
            <tr><td>Boosting rare question words that appear in function names</td><td>Fixed the search that inspired it and dropped the exam to 141 of 201</td><td>Dropped</td></tr>
            <tr><td>Watching files with a <em>watcher</em></td><td>Detecting changes already costs about 110 ms of searches that take 1.3 to 2 s</td><td>Not built</td></tr>
          </tbody>
        </table></div>
        <p>
          The second to last deserves a note: it is easy to design a rule while looking at the search that failed and convince yourself it improves the product. It fixed that case and broke 27 correct answers elsewhere. That is why no rule goes in without passing the exam.
        </p>

        <h2 id="lessons">Lessons on method</h2>
        <ol>
          <li><strong>Measure before building.</strong> A 20-question test avoided building on a model that was not fit for the job.</li>
          <li><strong>Every new implementation needs its own parity test.</strong> ONNX, Rust, Windows and INT8 all "loaded without errors"; only comparing against the original showed which ones gave the same results.</li>
          <li><strong>The exam must not be written while reading the answer.</strong> Questions written while looking at the code favored keyword search.</li>
          <li><strong>Review samples before scaling.</strong> Two samples of 50 questions fixed defects that would have contaminated 36,000.</li>
          <li><strong>A judge has to beat the strongest cheap rival.</strong> Beating the weakest looked like a success and was not.</li>
          <li><strong>Write the prediction before the result</strong> and open the test only once. With 100 questions, a 9-answer difference can be chance.</li>
          <li><strong>Break it down before celebrating.</strong> A jump from 269 to 315 came entirely from a dataset shortcut.</li>
          <li><strong>Watch memorization during training</strong>, not afterwards, and keep the best checkpoint.</li>
          <li><strong>Pick the teacher with a test.</strong> The most eye-catching model was not the best.</li>
          <li><strong>Design for the cloud failing.</strong> The provider shut down GPUs twice in the middle of a run; saving every result as it arrived turned that into minutes lost, not hours.</li>
          <li><strong>A rule that fixes one case can break forty.</strong> Every improvement is measured on the full exam, never on the example that inspired it.</li>
          <li><strong>Measure what you shipped, not what you think you shipped.</strong> A value changed by mistake left outlines at 2 lines for two releases; only the exam caught it.</li>
          <li><strong>A model's published numbers do not replace your own exam.</strong> A model with better results on public code benchmarks lost 14 searches on ours.</li>
        </ol>

        <h2 id="limits">Limits and costs</h2>
        <ul>
          <li>The exams have 200 questions: they detect differences of about 10 answers, not smaller ones.</li>
          <li>If the search does not bring the right function among the candidates, the judge cannot rescue it.</li>
          <li>Large GPU models are still better judges; s1-code wins on size, CPU, language parity, license and privacy.</li>
          <li>On a large repository everything becomes searchable within minutes, but the final quality (the full code of each function) takes longer: about 5 to 10 functions per second on a CPU.</li>
          <li>The judge was trained on Python: in other languages and in highly domain-specific code it gives low probabilities, and it cannot yet reliably say that the answer is not in the repository.</li>
          <li>The private repositories used for the exam and part of the training are not published; they are described only in aggregate.</li>
          <li>We have not yet measured the effect on a real agent (tokens or time saved), which is the comparison jevgrep makes.</li>
        </ul>
        <div class="tabla"><table>
          <thead><tr><th>Cloud GPU cost</th><th>USD (estimated)</th></tr></thead>
          <tbody>
            <tr><td>s1-code v1: questions, vectors, training (L4) and evaluation</td><td class="num">4–5</td></tr>
            <tr><td>s1-code v2: questions (4 L4), vectors, training (A100, 64 min) and evaluation</td><td class="num">10–11</td></tr>
            <tr><td>s1-code v3: vectors, 4B teacher, rival test, training (A100, 73 min)</td><td class="num">8–10</td></tr>
            <tr><td>s1grep: development and every measurement on CPU</td><td class="num">0</td></tr>
            <tr class="destacada"><td>Total</td><td class="num">22–26</td></tr>
          </tbody>
        </table></div>

        <h2 id="next">What comes next</h2>
        <ul>
          <li><strong>s1-code v4</strong>: a generalist judge trained on several languages from the start, with the same method and the same exam rules.</li>
          <li><strong>Being able to say "it is not here"</strong>: an exam with questions whose answer does not exist in the repository, and a judge calibrated to recognize them. That is what would matter most to an agent: to stop searching where there is nothing.</li>
          <li><strong>Measuring with real agents</strong>, on the same tasks jevgrep uses: how many files an agent reads and how many tokens it spends with and without s1grep.</li>
        </ul>
        <p>Each version is published only if it beats the previous one on the exam. If it does not, it gets reported anyway.</p>

